# Copia este archivo como .env (nunca subas el .env a git).
# API key de Euler Stream para firmar la conexión a TikTok LIVE (opcional; sin ella el límite es bajo).
EULER_API_KEY=
# Puerto local de la app (panel, overlays y WebSocket).
PORT=7420
# Carpeta de datos (por defecto ~/.livearena).
# LIVEARENA_DATA=
# debug | info | warn | error
LOG_LEVEL=info
