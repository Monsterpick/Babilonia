{
  "name": "livearena",
  "private": true,
  "version": "0.2.2",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @livearena/server --filter @livearena/dashboard dev",
    "dev:server": "pnpm --filter @livearena/server dev",
    "dev:dashboard": "pnpm --filter @livearena/dashboard dev",
    "build": "pnpm --filter @livearena/dashboard build",
    "start": "pnpm --filter @livearena/server start",
    "sim": "pnpm --filter @livearena/server sim",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/dashboard --noEmit",
    "desktop": "pnpm build && pnpm --filter @livearena/desktop start",
    "dist:win": "pnpm build && pnpm --filter @livearena/desktop dist"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}